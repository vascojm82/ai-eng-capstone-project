# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

OPENAI_API_KEY=<YOU_API_KEY>
OPENAI_BASE_URL=https://api.openai.com/v1
DATABASE_URL="postgres://<USERNAME>:<PASSWORD>@pooled.db.prisma.io:5432/postgres?sslmode=verify-full"

# Login accounts and the key that signs session cookies.
# Don't write these by hand: `npm run auth:users` generates both and saves the passwords to .credentials.local.
APP_USERS=user:user:<PASSWORD_HASH>,admin:admin:<PASSWORD_HASH>
SESSION_SECRET=<RANDOM_SECRET>

# Retell API key, from the Retell dashboard (Settings → API Keys) of your Retell workspace:
# the voice scripts create the agent in that workspace. Use the key with the webhook badge:
# /api/voice/ask checks Retell's request signatures with it.
# Required on Prisma even without the phone agent: then set it there to any placeholder, e.g. not-used.
RETELL_API_KEY=<YOUR_RETELL_API_KEY>

# Only for the voice scripts (npm run voice:setup, voice:on, voice:off), not needed on Prisma.
# The phone number you bought in that Retell workspace, in E.164 format.
RETELL_PHONE_NUMBER=<+1XXXXXXXXXX>
# Where the phone agent's tool sends questions: your deployed app's /api/voice/ask.
RETELL_TOOL_URL=https://<YOUR_APP_HOST>/api/voice/ask
