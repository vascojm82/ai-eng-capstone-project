# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

OPENAI_API_KEY=<YOU_API_KEY>
OPENAI_BASE_URL=https://api.openai.com/v1
DATABASE_URL="postgres://<USERNAME>:<PASSWORD>@pooled.db.prisma.io:5432/postgres?sslmode=verify-full"

# Login accounts and the key that signs session cookies.
# Don't write these by hand: `npm run auth:users` generates both and saves the passwords to .credentials.local.
APP_USERS=user:user:<PASSWORD_HASH>,admin:admin:<PASSWORD_HASH>
SESSION_SECRET=<RANDOM_SECRET>
