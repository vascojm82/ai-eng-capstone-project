// use prisma-8

// One row per year/model/trim (a row of manifest.csv).
model Vehicle {
  id        Int             @id @default(autoincrement()) @map("vehicle_id")
  make      String          @default("Acura")
  model     String
  year      Int
  trim      String
  modelCode String?         @map("model_code")
  market    String          @default("US")
  manuals   VehicleManual[]

  @@unique([year, model, trim, market])
  @@map("vehicles")
}

// One row per unique manual. Many trims share the same PDF, so the PDF is
// stored (and later chunked/embedded) exactly once. The local copy lives at
// data/acura_manuals/manuals_{year}/raw/{docCode}.PDF.
model Manual {
  id         Int                @id @default(autoincrement()) @map("manual_id")
  docCode    String             @unique @map("doc_code")
  title      String
  manualType ManualType         @map("manual_type")
  year       Int
  language   String             @default("en-US")
  edition    String?
  sourceUrl  String             @map("source_url")
  sha256     String?            @unique
  pageCount  Int?               @map("page_count")
  ingestedAt TimestamptzString? @map("ingested_at")
  // The PDF's hash before its last revision, and when that revision was seeded
  previousSha256     String?            @map("previous_sha256")
  updatedAt          TimestamptzString? @map("updated_at")
  // Content-Length and Last-Modified sent by the owner site for the PDF, so
  // `npm run manuals:check` can skip downloading manuals that haven't changed
  sourceSize         Int?               @map("source_size")
  sourceLastModified String?            @map("source_last_modified")
  vehicles   VehicleManual[]
  chunks     Chunk[]

  @@map("manuals")
}

model VehicleManual {
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  vehicleId Int     @map("vehicle_id")
  manual    Manual  @relation(fields: [manualId], references: [id], onDelete: Cascade)
  manualId  Int     @map("manual_id")

  @@id([vehicleId, manualId])
  @@map("vehicle_manuals")
}

// One searchable passage of a manual PDF, with its embedding for pgvector
// similarity search. Always filtered by manualId so answers never mix vehicles.
model Chunk {
  id           Int                    @id @default(autoincrement()) @map("chunk_id")
  manual       Manual                 @relation(fields: [manualId], references: [id], onDelete: Cascade)
  manualId     Int                    @map("manual_id")
  page         Int
  sectionTitle String?                @map("section_title")
  content      String
  embedding    pgvector.Vector(1536)

  @@index([manualId])
  @@map("chunks")
}

// One API key for the MCP tools (mcp-server/server.ts), owned by one external agent
// (`name`). Only the key's SHA-256 is stored, never the key: `npm run mcp:keys`
// creates a key, shows it once, and lists and revokes keys (mcp-server/keys.ts).
model McpKey {
  id          Int                @id @default(autoincrement()) @map("key_id")
  // Who the key is for, e.g. "Acme dealer bot"
  name        String
  // The key's first characters (e.g. "sam_8f3kQ2xa"), to tell keys apart in lists and logs
  keyPrefix   String             @unique @map("key_prefix")
  keyHash     String             @unique @map("key_hash")
  // Tool calls per hour with this key; null = the default (lib/limits.ts)
  hourlyLimit Int?               @map("hourly_limit")
  createdAt   TimestamptzString  @map("created_at")
  lastUsedAt  TimestamptzString? @map("last_used_at")
  // Set when the key is revoked; requests with it are refused from then on
  revokedAt   TimestamptzString? @map("revoked_at")

  @@map("mcp_keys")
}

enum ManualType {
  owner
  navigation
}
